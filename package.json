{
  "name": "crime-stats",
  "private": true,
  "description": "Visualisierung der Polizeilichen Kriminalstatistik (PKS) des BKA",
  "workspaces": [
    "shared",
    "etl",
    "app"
  ],
  "scripts": {
    "start": "npm start -w app",
    "build": "npm run build -w app",
    "crawl": "npm run crawl -w etl --",
    "etl": "npm run etl -w etl --",
    "typecheck": "tsc -p shared && tsc -p etl"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
